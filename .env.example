# Appwrite project used only for local/deployment tooling. Never commit the live values.
# Use HTTPS outside localhost/loopback development.
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=fyre-development
APPWRITE_DATABASE_ID=fyre

# Tables
APPWRITE_PROFILES_TABLE_ID=profiles
APPWRITE_EVENTS_TABLE_ID=events
APPWRITE_EVENT_REGISTRATIONS_TABLE_ID=eventregistrations
APPWRITE_THREADS_TABLE_ID=threads
APPWRITE_THREAD_PARTICIPANTS_TABLE_ID=threadparticipants
APPWRITE_MESSAGES_TABLE_ID=messages
APPWRITE_SWIPES_TABLE_ID=swipe
APPWRITE_MATCHES_TABLE_ID=matches
APPWRITE_RELATIONSHIPS_TABLE_ID=relationships

# Storage buckets
APPWRITE_AVATARS_BUCKET_ID=avatars
APPWRITE_CHAT_ATTACHMENTS_BUCKET_ID=chat-attachments

# Short-lived avatar bearer URLs issued only after discovery/chat authorization (300-900 seconds).
APPWRITE_AVATAR_TOKEN_TTL_SECONDS=300

# Functions
APPWRITE_REGISTER_FOR_EVENT_FUNCTION_ID=registerforevent
APPWRITE_CANCEL_EVENT_REGISTRATION_FUNCTION_ID=canceleventregistration
APPWRITE_EVENT_ADMIN_FUNCTION_ID=manageeventadmin
APPWRITE_CREATE_OR_GET_THREAD_FUNCTION_ID=createorgetthread
APPWRITE_SEND_MESSAGE_FUNCTION_ID=sendmessage
APPWRITE_RECORD_SWIPE_FUNCTION_ID=recordswipe
APPWRITE_DISCOVER_PROFILES_FUNCTION_ID=discoverprofiles
APPWRITE_MANAGE_PROFILE_FUNCTION_ID=manageprofile
APPWRITE_MANAGE_RELATIONSHIP_FUNCTION_ID=managerelationship

# Event administrators checked against the verified Appwrite Account.
# Keep real IDs and emails in the ignored .env file.
APPWRITE_EVENT_ADMIN_USER_IDS=
APPWRITE_EVENT_ADMIN_EMAILS=

# Optional public function domains. Prefer SDK executions; domains still require a JWT.
APPWRITE_CREATE_OR_GET_THREAD_FUNCTION_DOMAIN=
APPWRITE_SEND_MESSAGE_FUNCTION_DOMAIN=
APPWRITE_RECORD_SWIPE_FUNCTION_DOMAIN=
APPWRITE_DISCOVER_PROFILES_FUNCTION_DOMAIN=
APPWRITE_EVENT_ADMIN_FUNCTION_DOMAIN=
