# Local Android SDK path (Android Studio normally writes this automatically).
# sdk.dir=/absolute/path/to/Android/sdk

# Browser/client-visible configuration only: never put an Appwrite API key here.
APPWRITE_BACKEND_ENABLED=false
APPWRITE_ENDPOINT=<APPWRITE_ENDPOINT>
APPWRITE_PROJECT_ID=<APPWRITE_PROJECT_ID>
APPWRITE_DATABASE_ID=<APPWRITE_DATABASE_ID>
APPWRITE_PROFILES_TABLE_ID=<APPWRITE_PROFILES_TABLE_ID>
APPWRITE_AVATARS_BUCKET_ID=<APPWRITE_AVATARS_BUCKET_ID>
APPWRITE_EVENTS_TABLE_ID=<APPWRITE_EVENTS_TABLE_ID>
APPWRITE_EVENT_REGISTRATIONS_TABLE_ID=<APPWRITE_EVENT_REGISTRATIONS_TABLE_ID>
APPWRITE_THREADS_TABLE_ID=<APPWRITE_THREADS_TABLE_ID>
APPWRITE_THREAD_PARTICIPANTS_TABLE_ID=<APPWRITE_THREAD_PARTICIPANTS_TABLE_ID>
APPWRITE_MESSAGES_TABLE_ID=<APPWRITE_MESSAGES_TABLE_ID>
APPWRITE_REGISTER_FOR_EVENT_FUNCTION_ID=<APPWRITE_REGISTER_FOR_EVENT_FUNCTION_ID>
APPWRITE_CANCEL_EVENT_REGISTRATION_FUNCTION_ID=<APPWRITE_CANCEL_EVENT_REGISTRATION_FUNCTION_ID>
APPWRITE_MANAGE_PROFILE_FUNCTION_ID=<APPWRITE_MANAGE_PROFILE_FUNCTION_ID>
APPWRITE_CREATE_OR_GET_THREAD_FUNCTION_ID=<APPWRITE_CREATE_OR_GET_THREAD_FUNCTION_ID>
APPWRITE_SEND_MESSAGE_FUNCTION_ID=<APPWRITE_SEND_MESSAGE_FUNCTION_ID>

# Required core discovery and relationship resources.
APPWRITE_SWIPES_TABLE_ID=<APPWRITE_SWIPES_TABLE_ID>
APPWRITE_MATCHES_TABLE_ID=<APPWRITE_MATCHES_TABLE_ID>
APPWRITE_RELATIONSHIPS_TABLE_ID=<APPWRITE_RELATIONSHIPS_TABLE_ID>
APPWRITE_RECORD_SWIPE_FUNCTION_ID=<APPWRITE_RECORD_SWIPE_FUNCTION_ID>
APPWRITE_DISCOVER_PROFILES_FUNCTION_ID=<APPWRITE_DISCOVER_PROFILES_FUNCTION_ID>
APPWRITE_MANAGE_RELATIONSHIP_FUNCTION_ID=<APPWRITE_MANAGE_RELATIONSHIP_FUNCTION_ID>

# Optional resources/features; leave blank to disable them. Direct domains must use HTTPS outside loopback development.
APPWRITE_CHAT_ATTACHMENTS_BUCKET_ID=
APPWRITE_EVENT_ADMIN_FUNCTION_ID=
APPWRITE_CREATE_OR_GET_THREAD_FUNCTION_DOMAIN=
APPWRITE_SEND_MESSAGE_FUNCTION_DOMAIN=
APPWRITE_RECORD_SWIPE_FUNCTION_DOMAIN=
APPWRITE_DISCOVER_PROFILES_FUNCTION_DOMAIN=
APPWRITE_EVENT_ADMIN_FUNCTION_DOMAIN=
