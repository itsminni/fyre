[
  {
    "$id": "fyre-api",
    "name": "Fyre API",
    "runtime": "node-22",
    "path": "../functions",
    "entrypoint": "api/src/main.js",
    "commands": "",
    "execute": [
      "users"
    ],
    "events": [],
    "timeout": 15,
    "enabled": true,
    "logging": false,
    "scopes": [
      "files.read",
      "files.write",
      "rows.read",
      "rows.write",
      "tokens.write",
      "users.read"
    ],
    "vars": {
      "APPWRITE_DATABASE_ID": "fyre",
      "APPWRITE_PROFILES_TABLE_ID": "profiles",
      "APPWRITE_EVENTS_TABLE_ID": "events",
      "APPWRITE_EVENT_REGISTRATIONS_TABLE_ID": "eventregistrations",
      "APPWRITE_EVENT_ADMIN_USER_IDS": "",
      "APPWRITE_EVENT_ADMIN_EMAILS": "",
      "APPWRITE_THREADS_TABLE_ID": "threads",
      "APPWRITE_THREAD_PARTICIPANTS_TABLE_ID": "threadparticipants",
      "APPWRITE_RELATIONSHIPS_TABLE_ID": "relationships",
      "APPWRITE_AVATARS_BUCKET_ID": "avatars",
      "APPWRITE_AVATAR_TOKEN_TTL_SECONDS": "300",
      "APPWRITE_MESSAGES_TABLE_ID": "messages",
      "APPWRITE_ATTACHMENT_OPERATIONS_TABLE_ID": "attachmentoperations",
      "APPWRITE_CHAT_ATTACHMENTS_BUCKET_ID": "avatars",
      "APPWRITE_CLEANUP_HEALTH_TABLE_ID": "cleanuphealth",
      "APPWRITE_SWIPES_TABLE_ID": "swipe",
      "APPWRITE_MATCHES_TABLE_ID": "matches"
    },
    "interval": 0
  },
  {
    "$id": "cleanupattachments",
    "name": "Clean up chat attachments",
    "runtime": "node-22",
    "path": "../functions/sendmessage",
    "entrypoint": "src/cleanup.js",
    "commands": "",
    "execute": [],
    "events": [],
    "timeout": 60,
    "enabled": true,
    "logging": false,
    "scopes": [
      "rows.read",
      "rows.write",
      "files.read",
      "files.write"
    ],
    "vars": {
      "APPWRITE_DATABASE_ID": "fyre",
      "APPWRITE_THREADS_TABLE_ID": "threads",
      "APPWRITE_THREAD_PARTICIPANTS_TABLE_ID": "threadparticipants",
      "APPWRITE_MESSAGES_TABLE_ID": "messages",
      "APPWRITE_ATTACHMENT_OPERATIONS_TABLE_ID": "attachmentoperations",
      "APPWRITE_CHAT_ATTACHMENTS_BUCKET_ID": "avatars",
      "APPWRITE_RELATIONSHIPS_TABLE_ID": "relationships",
      "APPWRITE_PROFILES_TABLE_ID": "profiles",
      "APPWRITE_AVATARS_BUCKET_ID": "avatars",
      "APPWRITE_CLEANUP_HEALTH_TABLE_ID": "cleanuphealth"
    },
    "interval": 60
  }
]
